{
  "name": "ai-browser-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm build:web && pnpm typecheck && pnpm test",
    "dev:fixtures": "node --env-file-if-exists=.env apps/fixtures/src/server.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "demo": "node apps/cli/src/main.ts",
    "history": "node apps/cli/src/history.ts",
    "dev:api": "pnpm build:web && node --env-file-if-exists=.env apps/api/src/main.ts",
    "evaluate:read": "node apps/cli/src/evaluate.ts",
    "build:web": "node apps/web/build.ts"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
